{
  "name": "@flashyos/conformance-kit",
  "version": "0.1.0",
  "description": "Run a conformance corpus against any executable, in any language.",
  "license": "Apache-2.0",
  "author": "Flashy Labs",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/flashylabs/conformance-kit.git"
  },
  "homepage": "https://github.com/flashylabs/conformance-kit#readme",
  "bugs": "https://github.com/flashylabs/conformance-kit/issues",
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "conformance",
    "conformance-testing",
    "interoperability",
    "specification",
    "test-harness",
    "protocol",
    "standards",
    "cli",
    "zero-dependencies"
  ],
  "bin": {
    "conformance-kit": "./src/cli.mjs"
  },
  "types": "./src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "default": "./src/index.mjs"
    }
  },
  "files": [
    "src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test src/conformance-run.test.mjs src/drift.test.mjs src/types.test.mjs"
  }
}
